# Heavy binaries and local AI models (>100MB, rejected by GitHub)
backend/bin/*.exe
!backend/bin/.gitkeep
backend/storage/temp/models/
backend/storage/temp/*
!backend/storage/temp/.gitkeep

# User media storage (video recordings can be hundreds of MB)
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/storage/exports/*
!backend/storage/exports/.gitkeep

